@@ -221,6 +226,13 @@ - (UIViewController *)findCachedControllerForView:(UIView *)view {
 }
 
 - (void)updateDataSource {
+    if ([self isUserScrolling]) {
+        _pendingDataSourceUpdate = YES;
+        [self retryPendingNavigation];
+        return;
+    }
+    _pendingDataSourceUpdate = NO;
+
     if (!self.currentView && self.reactSubviews.count == 0) {
         return;
     }
@@ -257,6 +269,14 @@ - (void)goTo:(NSInteger)index animated:(BOOL)animated {
     if (index == _currentIndex) {
         return;
     }
