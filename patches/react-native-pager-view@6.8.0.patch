     [self disableSwipe];
     
@@ -402,6 +422,67 @@ - (void)scrollViewWillEndDragging:(UIScrollView *)scrollView withVelocity:(CGPoi
 
 - (void)scrollViewDidEndDecelerating:(UIScrollView *)scrollView {
     [self.eventDispatcher sendEvent:[[RCTOnPageScrollStateChanged alloc] initWithReactTag:self.reactTag state:@"idle" coalescingKey:_coalescingKey++]];
+    [self schedulePendingNavigation];
+}
+
+- (void)scrollViewDidEndDragging:(UIScrollView *)scrollView willDecelerate:(BOOL)decelerate {
+    if (!decelerate) {
+        [self schedulePendingNavigation];
+    }
+}
+
+- (BOOL)isUserScrolling {
+    return self.scrollView.isTracking || self.scrollView.isDragging || self.scrollView.isDecelerating;
+}
+
+- (BOOL)hasPendingNavigation {
+    return _pendingIndex >= 0 || _pendingDataSourceUpdate;
+}
+
+// Let UIPageViewController finish its own manual-scroll transition before
+// calling setViewControllers again; doing it mid-transition aborts in UIKit.
+- (void)schedulePendingNavigation {
+    if (![self hasPendingNavigation]) {
+        return;
+    }
+    __weak RNCPagerView *weakSelf = self;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        [weakSelf applyPendingNavigation];
+    });
+}
+
+- (void)retryPendingNavigation {
+    if (_pendingRetryScheduled) {
+        return;
+    }
+    _pendingRetryScheduled = YES;
+    __weak RNCPagerView *weakSelf = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, (int64_t)(0.1 * NSEC_PER_SEC)), dispatch_get_main_queue(), ^{
+        __strong RNCPagerView *strongSelf = weakSelf;
+        if (strongSelf) {
+            strongSelf->_pendingRetryScheduled = NO;
+            [strongSelf applyPendingNavigation];
+        }
+    });
+}
+
+- (void)applyPendingNavigation {
+    if (![self hasPendingNavigation]) {
+        return;
+    }
+    if ([self isUserScrolling]) {
+        [self retryPendingNavigation];
+        return;
+    }
+    NSInteger index = _pendingIndex;
+    BOOL animated = _pendingAnimated;
+    if (_pendingDataSourceUpdate) {
+        [self updateDataSource];
+    }
+    _pendingIndex = -1;
+    if (index >= 0 && index < (NSInteger)self.reactSubviews.count) {
+        [self goTo:index animated:animated];
+    }
 }
 
